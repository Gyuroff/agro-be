# Копирай като .env и попълни. Реалният .env е в .gitignore — тайни никога в git.
# Всички ключове от docs/architecture.md §6. Стойностите са празни; примерите са в коментарите.
# За docker compose services (api/worker/beat) хостовете на postgres/redis/greenmail се подават
# от docker-compose.yml и надделяват над този файл.

APP_ENV=                      # dev | test | prod
APP_DATABASE_URL=             # postgresql+psycopg://agro:agro@localhost:5432/agro
APP_REDIS_URL=                # redis://localhost:6379/0
APP_JWT_SECRET=               # 64 случайни байта (access token)
APP_ADMIN_SESSION_SECRET=     # 64 случайни байта (бисквитка на админа)

# Файлове: първо S3, локалната папка е само опашка при S3 fail
APP_STORAGE_DIR=              # /var/lib/agro/storage
APP_S3_ENDPOINT=              # https://fsn1.your-objectstorage.com
APP_S3_REGION=                # fsn1
APP_S3_BUCKET=                # agro-prod
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=

# Бекъп: второ хранилище (APP_BACKUP_S3_*) или независима машина (APP_BACKUP_SSH_*) — §11
APP_BACKUP_S3_ENDPOINT=
APP_BACKUP_S3_REGION=
APP_BACKUP_S3_BUCKET=
APP_BACKUP_S3_ACCESS_KEY=
APP_BACKUP_S3_SECRET_KEY=
APP_BACKUP_SSH_HOST=
APP_BACKUP_SSH_USER=
APP_BACKUP_SSH_KEY_FILE=

# Поща (отворен въпрос 1). Локално: GreenMail — IMAP 3143, SMTP 3025
APP_IMAP_HOST=                # localhost
APP_IMAP_PORT=                # 3143
APP_IMAP_USER=
APP_IMAP_PASSWORD=
APP_IMAP_SSL=                 # false за GreenMail
APP_SMTP_HOST=                # localhost
APP_SMTP_PORT=                # 3025
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_SMTP_STARTTLS=            # false за GreenMail
APP_MAIL_AUTHSERV_ID=         # mx.google.com

# LLM (docs/llm.md): stub = fixtures (CI и pytest)
APP_LLM_PROVIDER=             # anthropic | stub
APP_LLM_API_KEY=              # sk-ant-…
APP_LLM_MODEL_DEFAULT=        # claude-sonnet-5-5
# Per-agent override: APP_LLM_MODEL_<AGENT> — имената са в docs/llm.md §2

# Пуш
APP_FCM_CREDENTIALS_FILE=     # /run/secrets/firebase.json
APP_HMS_APP_ID=               # празно, докато не се реши отворен въпрос 15
APP_HMS_CLIENT_ID=
APP_HMS_CLIENT_SECRET=

# Само ако се ползва webhook източник за пощата
APP_INGEST_TOKEN=

# Мега (отворен въпрос 12)
APP_MEGA_TEST_EXPORT_DIR=
APP_MEGA_PROD_EXPORT_DIR=

APP_CORS_ORIGINS=             # празно: мобилното приложение не ползва CORS
APP_LLM_MODEL_EMAIL_CLASSIFIER=   # claude-haiku-5-5 (остава и при празно)
APP_LLM_MODEL_CANCELLATION_PARSER= # claude-haiku-5-5
# APP_LLM_MODEL_<REQUEST_PARSER|REPORT_PARSER|REPORT_MATCHER|MEGA_INVOICE_PARSER|INVOICE_COMPARATOR> — по избор
APP_LLM_EFFORT_DEFAULT=       # medium

# Сийд за разработка (scripts/seed_dev.py) — без префикс APP_
SEED_PASSWORD=                # парола на 4-мата съдружници
SEED_EMAIL_DOMAIN=            # по подразбиране agro.example → georgi@agro.example
